{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },

  "Monitor": {
    // Integrated Security: the service runs under a domain account that has
    // read access to ReVue. No credentials live in this string. See README.md.
    "ConnectionString": "Data Source=sqlProd.saas.amherst.com;Initial Catalog=ReVue;Integrated Security=True;TrustServerCertificate=true;MultipleActiveResultSets=True;Application Name=ReVUe.Helper.Monitor",

    // Directory for local state files (watermark + pending queue) and secrets.json.
    // Must be writable by the service account. Survives restarts.
    "StateDirectory": "C:\\ProgramData\\ReVUeHelper_Monitor",

    // Detection: dbo.LogEvents rows where Logger == this value AND Username is on
    // the watchlist (watchlist comes from secrets.json — see WatchUsers).
    "Logger": "WhoAmI",

    // Max rows pulled per poll (safety cap; watermark advances so we never re-read).
    "BatchSize": 200,

    // On very first run (no watermark file yet): if true, seed the watermark to the
    // current MAX(LogEventId) so we alert only on NEW logins, not the whole history.
    "SeedFromCurrentMaxOnFirstRun": true,

    // All window/time math uses this zone. Windows Server 2016 uses this Id format.
    "TimeZone": "Eastern Standard Time",

    // How the event's timestamp is determined. The [Date] column is varchar(100),
    // e.g. "2026-04-18 02:00:14.0672". Best-effort TryParse handles this (and varying
    // fractional digits) fine, so leave blank; if a row fails to parse we fall back to
    // the time the service observed it. Set an exact format only if TryParse proves unreliable.
    "EventDateFormat": "",

    "Poll": {
      "BusinessDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ],
      // Weekday DAY window (08:00-19:00): poll every 5 min.
      "DayStart": "08:00",
      "DayEnd": "19:00",
      "DayIntervalMinutes": 5,
      // Weekday NIGHT (19:00-08:00) AND all weekend: one soft ping per hour.
      "OffHoursIntervalMinutes": 60
    },

    "Email": {
      "Enabled": true,
      // No cooldown, no window: every matching login sends an email, any time of day.
      // Anonymous relay, same as ReVUeHelper_OSS/EmailService.cs.
      "SmtpHost": "dfsmtpout.root.amherst.com",
      "SmtpPort": 25,
      "UseSsl": false,
      "From": "efrunza@amherst.com",
      "To": [ "efrunza@amherst.com" ]
    },

    "Ntfy": {
      // The urgent, windowed push channel (ntfy.sh). Unauthenticated POST; the hard-to-guess
      // topic name is the only access control (accepted risk).
      "Enabled": true,
      "BaseUrl": "https://ntfy.sh",
      "Topic": "amh-revue-monitor-x100x1",
      "Title": "ReVUe login",
      "Priority": 5,
      "WindowStart": "08:30",
      "WindowEnd": "21:00",
      "CooldownHours": 3,
      "SuppressOnWeekends": true
    }
  }
}
